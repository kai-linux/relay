# Required: OpenAI API key (used for Whisper STT and TTS)
OPENAI_API_KEY=sk-...

# Optional: STT/TTS model settings
# RELAY_STT_MODEL=whisper-1
# RELAY_TTS_MODEL=tts-1
# RELAY_TTS_VOICE=nova

# Optional: agent settings
# RELAY_AGENT_BACKEND=claude-code
# RELAY_WORK_DIR=/path/to/your/project
# RELAY_AGENT_TIMEOUT=300

# Optional: server settings
# RELAY_HOST=0.0.0.0
# RELAY_PORT=5000
# RELAY_SECRET_KEY=change-me-in-production
